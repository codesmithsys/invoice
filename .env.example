# run `cp .env.example .env.local`

# for server side
SENTRY_ENABLED="false"
# for client side
NEXT_PUBLIC_SENTRY_ENABLED="false"

NEXT_PUBLIC_SENTRY_DSN=""


# Resend (For emails) Create account and paste API keys in .env.local 
RESEND_API_KEY=""

# Upstash Redis (For subscription tokens) Create account and paste API keys in .env.local 
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Used for /api
AUTH_TOKEN=""

# Personal Info for sending invoice automatically, check /api/generate-invoice

# From (Your) Info
FROM_NAME="Adam Smith"
FROM_ADDRESS="London, UK"
FROM_VAT_NO="12345"
FROM_EMAIL="from@mail.com"
FROM_ACCOUNT_NUMBER="12345"
FROM_SWIFT_BIC="12345"

# To (Client) Information
TO_NAME="Random Company"
TO_ADDRESS="Bristol, UK"
TO_VAT_NO="12345"
TO_EMAIL="to@mail.com"

INVOICE_NET_PRICE="10000"
INVOICE_EMAIL_RECIPIENT="from@mail.com"
INVOICE_EMAIL_COMPANY_TO="to@mail.com"

# Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google drive api
GOOGLE_DRIVE_CLIENT_EMAIL="example@mail.com"
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_PARENT_FOLDER_ID=""